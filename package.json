{
  "name": "dsh-miaopeng-kit",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "miaopeng 的 DeepSeek Harness 整合插件：外观（claude-style）+ WorkBuddy 模型 + /autocompact + 按阈值的上下文环 + 模型选择器改版 + 窗口尺寸记忆",
  "author": "miaopeng",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "scripts",
    "README.md"
  ],
  "dependencies": {
    "dsh-claude-style": "0.19.5",
    "@huai_xin/dsh-workbuddy": "0.8.3",
    "dsh-context": "0.77.0",
    "dshmarket": "1.73.1",
    "dsh-better-sidebar": "0.28.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "kit": {
      "$comment": "install.ps1 用：安装时移除这些被本插件取代或重复的插件，以及它们留在 profile patch 里的配置段。 bundles 列出由本组合包代为启用的插件，它们不应再单独出现在 profile 的组合包列表里。",
      "remove": [
        "@huai_xin/dsh-model-picker",
        "dsh-whale-widget",
        "dsh-model-rate-badge",
        "dsh-context-threshold-mark",
        "dsh-spider-kit"
      ],
      "removePatchIds": [],
      "bundles": [
        "@huai_xin/dsh-workbuddy",
        "dsh-claude-style",
        "dsh-context",
        "dshmarket",
        "dsh-better-sidebar"
      ]
    }
  }
}
