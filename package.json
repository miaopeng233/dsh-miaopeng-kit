{
  "name": "dsh-miaopeng-kit",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "miaopeng 的 DeepSeek Harness 整合插件：外观（claude-style）+ WorkBuddy 模型 + /autocompact + 按阈值的上下文环 + 模型选择器改版 + 窗口尺寸记忆",
  "author": "miaopeng",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "defaults.patch.yml", "scripts", "README.md"],
  "dependencies": {
    "dsh-claude-style": "0.19.5",
    "@huai_xin/dsh-workbuddy": "0.8.3"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "kit": {
      "$comment": "随本插件一起启用的上游插件（版本锁定在 dependencies 里）。顺序即加载顺序，本插件总在最后。",
      "bundles": ["@huai_xin/dsh-workbuddy", "dsh-claude-style"],
      "remove": [
        "dshmarket",
        "dsh-better-sidebar",
        "dsh-context",
        "@huai_xin/dsh-model-picker",
        "dsh-whale-widget",
        "dsh-model-rate-badge",
        "dsh-context-threshold-mark",
        "dsh-spider-kit"
      ],
      "removePatchIds": ["better-sidebar", "dsh-context"]
    }
  }
}
